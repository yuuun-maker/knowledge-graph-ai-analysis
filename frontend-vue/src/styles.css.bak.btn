
@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn-vue/tailwind.css";

@custom-variant dark (&:is(.dark *));

/* ==========================================================================
   Design System · 「靛蓝科技」视觉体系 v2
   —— 服务外包大赛演示级 UI：现代靛蓝主色、柔和层次阴影、玻璃质感、全局动效
   旧 token 名全部保留（组件已大量引用），仅升级取值并扩展语义层。
   ========================================================================== */
:root {
  /* ---- 品牌色阶（Indigo × Blue，供渐变/描边/光晕复用） ---- */
  --brand-50: #eef3ff;
  --brand-100: #dfe8ff;
  --brand-200: #c2d3ff;
  --brand-300: #97b4ff;
  --brand-400: #6f8efb;
  --brand-500: #4f6ef7;
  --brand-600: #3d56e8;
  --brand-700: #3144c4;
  --brand-800: #2b3b9e;
  --brand-900: #28367d;
  --accent-cyan: #14b8d6;
  --accent-violet: #8b5cf6;
  --gradient-brand: linear-gradient(135deg, #5b8def 0%, #6a5cf6 100%);
  --gradient-brand-soft: linear-gradient(135deg, rgba(91,141,239,.12), rgba(106,92,246,.12));

  /* ---- 统一 Color Token（hex，与 Element Plus 主题映射一致） ---- */
  --color-primary: #4f6ef7;
  --color-primary-hover: #6f8efb;
  --color-primary-active: #3d56e8;
  --color-primary-light: #eef3ff;
  --color-success: #18b87a;
  --color-warning: #f59e0b;
  --color-danger: #f5475d;
  --color-info: #94a0b8;
  --color-bg-page: #f3f5fb;
  --color-bg-surface: #ffffff;
  --color-bg-soft: #f7f9fe;
  --color-bg-hover: #eef3ff;
  --color-text-primary: #1c2438;
  --color-text-regular: #4a5468;
  --color-text-secondary: #8590a8;
  --color-text-muted: #b6bfd2;
  --color-border: #e6eaf3;
  --color-border-light: #eef1f7;

  /* ---- 统一 Spacing Token（4/8 网格） ---- */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;

  /* ---- Typography ---- */
  --font-family-base: 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  --font-family-number: 'DIN Alternate', 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  --font-size-title: 21px;
  --font-size-section: 15px;
  --font-size-body: 14px;
  --font-size-caption: 12px;
  --font-size-label: 13px;
  --font-size-number: 24px;
  --font-weight-regular: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  /* ---- 主色（旧名兼容） ---- */
  --primary: oklch(0.58 0.19 264);
  --primary-hover: #6f8efb;
  --primary-active: #3d56e8;
  --primary-light: #eef3ff;
  --primary-lighter: #f4f7ff;

  /* ---- 语义色（现代微调） ---- */
  --success: #18b87a;
  --warning: #f59e0b;
  --danger: #f5475d;
  --info: #94a0b8;

  /* ---- 背景 ---- */
  --bg-page: #f3f5fb;
  --bg-card: #ffffff;
  --bg-hover: rgba(79, 110, 247, 0.08);
  --bg-soft: #f7f9fe;
  --sidebar-bg: #101736;
  --sidebar-bg-deep: #0b1029;

  /* ---- 文本 ---- */
  --text-primary: #1c2438;
  --text-regular: #4a5468;
  --text-secondary: #8590a8;
  --text-muted: #b6bfd2;
  --text-inverse: #ffffff;
  --text-sidebar: #aab3d4;
  --text-sidebar-muted: #6b7499;

  /* ---- 边框 ---- */
  --border-color: #e6eaf3;
  --border-light: #eef1f7;
  --border-sidebar: rgba(255, 255, 255, 0.07);

  /* ---- 阴影（三层柔和体系） ---- */
  --shadow-card: 0 1px 2px rgba(22, 34, 66, 0.04), 0 6px 20px -10px rgba(22, 34, 66, 0.08);
  --shadow-hover: 0 4px 12px rgba(22, 34, 66, 0.06), 0 16px 40px -16px rgba(49, 68, 196, 0.22);
  --shadow-float: 0 12px 40px -8px rgba(28, 36, 56, 0.22);
  --shadow-primary: 0 8px 20px -8px rgba(79, 110, 247, 0.45);

  /* ---- 圆角 ---- */
  --radius-sm: 7px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-xl: 18px;
  --radius-round: 50%;

  /* ---- 布局 ---- */
  --sidebar-width: 232px;
  --sidebar-width-collapsed: 64px;
  --header-height: 58px;

  /* ---- Element Plus 主题映射 ---- */
  --el-color-primary: #4f6ef7;
  --el-color-primary-light-3: #7c92fa;
  --el-color-primary-light-5: #a3b2fc;
  --el-color-primary-light-7: #c9d2fd;
  --el-color-primary-light-8: #dce3fe;
  --el-color-primary-light-9: #eef3ff;
  --el-color-primary-dark-2: #3d56e8;
  --el-color-success: #18b87a;
  --el-color-warning: #f59e0b;
  --el-color-danger: #f5475d;
  --el-border-radius-base: 9px;
  --el-box-shadow-light: 0 1px 2px rgba(22,34,66,.04), 0 6px 20px -12px rgba(22,34,66,.1);
  --background: oklch(1 0 0);
  --foreground: oklch(0.145 0 0);
  --card: oklch(1 0 0);
  --card-foreground: oklch(0.145 0 0);
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.145 0 0);
  --primary-foreground: oklch(0.985 0 0);
  --secondary: oklch(0.97 0 0);
  --secondary-foreground: oklch(0.205 0 0);
  --muted: oklch(0.97 0 0);
  --muted-foreground: oklch(0.556 0 0);
  --accent: oklch(0.97 0 0);
  --accent-foreground: oklch(0.205 0 0);
  --destructive: oklch(0.577 0.245 27.325);
  --border: oklch(0.922 0 0);
  --input: oklch(0.922 0 0);
  --ring: oklch(0.708 0 0);
  --chart-1: oklch(0.87 0 0);
  --chart-2: oklch(0.556 0 0);
  --chart-3: oklch(0.439 0 0);
  --chart-4: oklch(0.371 0 0);
  --chart-5: oklch(0.269 0 0);
  --radius: 0.75rem;
  --sidebar: oklch(0.985 0 0);
  --sidebar-foreground: oklch(0.145 0 0);
  --sidebar-primary: oklch(0.205 0 0);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.97 0 0);
  --sidebar-accent-foreground: oklch(0.205 0 0);
  --sidebar-border: oklch(0.922 0 0);
  --sidebar-ring: oklch(0.708 0 0);
}

html,
body,
#app {
  height: 100%;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  background-color: var(--bg-page);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* ==========================================================================
   全局动效关键帧
   ========================================================================== */
@keyframes kg-fade-up {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes kg-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes kg-pop-in {
  0% { opacity: 0; transform: scale(.96); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes kg-spin-glow {
  to { transform: rotate(360deg); }
}
@keyframes kg-pulse-ring {
  0% { box-shadow: 0 0 0 0 rgba(79,110,247,.35); }
  70% { box-shadow: 0 0 0 8px rgba(79,110,247,0); }
  100% { box-shadow: 0 0 0 0 rgba(79,110,247,0); }
}

/* ==========================================================================
   Element Plus 全局精致化
   ========================================================================== */
.el-main {
  --el-bg-color: var(--bg-page);
}

/* 卡片：统一圆角 + 柔和层次阴影 + 细边 */
.el-card {
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card) !important;
  border: 1px solid var(--border-light);
  transition: box-shadow .25s ease, transform .25s ease, border-color .25s ease;
}

/* 主按钮：品牌渐变 + 投影 */
.el-button--primary {
  background: var(--gradient-brand);
  border: none;
  box-shadow: 0 4px 12px -4px rgba(79, 110, 247, .5);
  font-weight: 500;
}
.el-button--primary:hover,
.el-button--primary:focus {
  background: linear-gradient(135deg, #6b9af5 0%, #7d6ff8 100%);
  box-shadow: 0 6px 16px -4px rgba(79, 110, 247, .55);
  transform: translateY(-1px);
}
.el-button--primary:active {
  transform: translateY(0);
  background: linear-gradient(135deg, #4663e0 0%, #5a4be0 100%);
}
.el-button.is-plain {
  border-radius: 9px;
}
/* plain 主按钮：保持浅底可读（上面 .el-button--primary 的深色渐变仅作用于实心按钮） */
.el-button--primary.is-plain {
  background: rgba(91, 141, 239, .08);
  border: 1px solid rgba(91, 141, 239, .45);
  color: #3b5bdb;
  box-shadow: none;
}
.el-button--primary.is-plain:hover,
.el-button--primary.is-plain:focus {
  background: rgba(91, 141, 239, .16);
  border-color: rgba(91, 141, 239, .7);
  color: #2f4ec7;
  transform: translateY(-1px);
}
.el-button--primary.is-plain:active {
  background: rgba(91, 141, 239, .22);
  transform: translateY(0);
}
.el-button {
  border-radius: 9px;
  transition: all .2s ease;
}
.el-button:focus-visible {
  outline: 2px solid var(--brand-300);
  outline-offset: 1px;
}

/* 输入框：聚焦柔光环 */
.el-input__wrapper {
  border-radius: 9px;
  transition: box-shadow .2s ease;
}
.el-input__wrapper.is-focus,
.el-textarea__inner:focus {
  box-shadow: 0 0 0 3px rgba(79, 110, 247, .12) !important;
}
.el-select .el-input__wrapper.is-focus {
  box-shadow: 0 0 0 3px rgba(79, 110, 247, .12) !important;
}

/* 标签：胶囊化 */
.el-tag {
  border-radius: 7px;
  font-weight: 500;
}
.el-tag--small {
  border-radius: 6px;
  padding: 0 7px;
  height: 20px;
  line-height: 19px;
}

/* 表格：轻量分隔 + 表头浅底 + 行悬浮 */
.el-table {
  --el-table-border-color: var(--border-light);
  --el-table-header-bg-color: #f7f9fe;
  --el-table-header-text-color: #4a5468;
  --el-table-row-hover-bg-color: #f2f6ff;
  border-radius: var(--radius-md);
}
.el-table th.el-table__cell {
  font-weight: 600;
  font-size: 13px;
  color: #4a5468;
}
.el-table .el-table__cell {
  padding: 10px 0;
}

/* 进度条圆角 */
.el-progress-bar__outer {
  border-radius: 999px;
}
.el-progress-bar__inner {
  border-radius: 999px;
  transition: width .6s cubic-bezier(.22,.8,.36,1);
}

/* Tabs：现代下划线 */
.el-tabs__item {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-secondary);
  transition: color .2s ease;
}
.el-tabs__item.is-active {
  color: var(--color-primary);
  font-weight: 600;
}
.el-tabs__active-bar {
  height: 3px;
  border-radius: 3px 3px 0 0;
  background: var(--gradient-brand);
}
.el-tabs__nav-wrap::after {
  height: 1px;
  background-color: var(--border-light);
}

/* 对话框/弹出层圆角与阴影 */
.el-dialog,
.el-message-box {
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-float);
  overflow: hidden;
}
.el-popover.el-popper,
.el-popper.is-light {
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-float) !important;
  border: 1px solid var(--border-light) !important;
}
.el-dropdown__popper .el-dropdown-menu {
  border-radius: var(--radius-md);
  padding: 4px;
}

/* 描述列表 */
.el-descriptions__label {
  color: var(--text-secondary) !important;
  font-weight: 500 !important;
  background: #fafbfe !important;
}

/* 空状态更轻盈 */
.el-empty__description p {
  color: var(--text-secondary);
  font-size: 13px;
}

/* ===== 图谱画布容器（点阵科技底纹，组件内可覆盖） ===== */
.graph-container {
  width: 100%;
  height: 100%;
  min-height: 520px;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background-color: #fbfcff;
  background-image:
    radial-gradient(circle, rgba(79,110,247,.10) 1px, transparent 1px);
  background-size: 22px 22px;
  overflow: hidden;
}

/* ===== 通用页面卡片 ===== */
.page-card {
  margin-bottom: 16px;
  border-radius: var(--radius-lg) !important;
  box-shadow: var(--shadow-card) !important;
  animation: kg-fade-up .45s cubic-bezier(.22,.8,.36,1) both;
}
.page-card:nth-child(2) { animation-delay: .04s; }
.page-card:nth-child(3) { animation-delay: .08s; }
.page-card:nth-child(4) { animation-delay: .12s; }
.page-card:nth-child(5) { animation-delay: .16s; }
.page-card :deep(.el-card__header),
.page-card > .el-card__header {
  padding: 14px 18px;
  border-bottom: 1px solid var(--border-light);
  font-weight: 600;
}
.page-card > .el-card__body {
  padding: 16px 18px;
}

/* ===== 聊天区域滚动条美化 ===== */
.chat-scroll {
  overflow-y: auto;
}
.chat-scroll::-webkit-scrollbar {
  width: 6px;
}
.chat-scroll::-webkit-scrollbar-thumb {
  background: #d6dcec;
  border-radius: 3px;
}

/* ===== Tab 面板适配 ===== */
.el-tabs :deep(.el-tabs__header) {
  background: var(--bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 0 16px;
  margin: 0 0 14px;
}
.el-tabs :deep(.el-tabs__content) {
  padding: 0;
}
.el-tabs :deep(.el-tab-pane) {
  padding: 0;
}

/* ===== 工具栏 ===== */
.toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.stats-text {
  color: var(--text-secondary);
  font-size: 13px;
}
.graph-card {
  height: 640px;
}
.graph-card > .el-card__body {
  height: 100%;
  padding: 12px;
}

/* ===== 问答区域 ===== */
.qa-card {
  max-width: 860px;
  background: var(--bg-card);
  border-radius: var(--radius-lg) !important;
  box-shadow: var(--shadow-card) !important;
}
.qa-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.chat-box {
  height: 460px;
  padding: 12px;
  background: var(--bg-soft);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
}

/* Tab 标签图标对齐 */
.tab-label {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

/* ===== 全局滚动条统一 ===== */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-thumb {
  background: #cfd6e6;
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: #b3bdd4;
}
::-webkit-scrollbar-track {
  background: transparent;
}

/* ===== 通用工具类 ===== */
.kg-gradient-text {
  background: var(--gradient-brand);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
.kg-glass {
  background: rgba(255, 255, 255, .72);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255, 255, 255, .6);
}

@theme inline {
  --font-sans: 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  --font-heading: var(--font-sans);
  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);
  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);
  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);
  --color-destructive: var(--destructive);
  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  --color-foreground: var(--foreground);
  --color-background: var(--background);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

.dark {
  --background: oklch(0.145 0 0);
  --foreground: oklch(0.985 0 0);
  --card: oklch(0.205 0 0);
  --card-foreground: oklch(0.985 0 0);
  --popover: oklch(0.205 0 0);
  --popover-foreground: oklch(0.985 0 0);
  --primary: oklch(0.922 0 0);
  --primary-foreground: oklch(0.205 0 0);
  --secondary: oklch(0.269 0 0);
  --secondary-foreground: oklch(0.985 0 0);
  --muted: oklch(0.269 0 0);
  --muted-foreground: oklch(0.708 0 0);
  --accent: oklch(0.269 0 0);
  --accent-foreground: oklch(0.985 0 0);
  --destructive: oklch(0.704 0.191 22.216);
  --border: oklch(1 0 0 / 10%);
  --input: oklch(1 0 0 / 15%);
  --ring: oklch(0.556 0 0);
  --chart-1: oklch(0.87 0 0);
  --chart-2: oklch(0.556 0 0);
  --chart-3: oklch(0.439 0 0);
  --chart-4: oklch(0.371 0 0);
  --chart-5: oklch(0.269 0 0);
  --sidebar: oklch(0.205 0 0);
  --sidebar-foreground: oklch(0.985 0 0);
  --sidebar-primary: oklch(0.488 0.243 264.376);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.269 0 0);
  --sidebar-accent-foreground: oklch(0.985 0 0);
  --sidebar-border: oklch(1 0 0 / 10%);
  --sidebar-ring: oklch(0.556 0 0);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
    @apply font-sans;
  }
}

/* ===== 可访问性：键盘焦点可见 ===== */
:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}
