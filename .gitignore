# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.env
*.egg

# 虚拟环境
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 上传文件（注意：写成 data/uploads/ 会被锚定在仓库根，对 backend/data/uploads/ 不生效，
# 必须补上 backend/ 前缀，否则用户上传的原始文档会被误提交进版本库）
data/uploads/
backend/data/uploads/

# Neo4j
neo4j/data/

# SQLite WAL 边车文件（阶段 G 启用 journal_mode=WAL 后产生）
# 注意：这些是**运行期**文件，不属于版本库；而恢复备份需要的是完整快照，
# 故备份一律走 sql_db.backup_to()（官方 backup API）而非裸拷 .db。
backend/data/*.db-wal
backend/data/*.db-shm

# 运行期数据库快照与日志（体积大且可再生成，不入库；
# 恢复流程需要的中间快照请留在本地 backup/ 目录，或走 sql_db.backup_to() 现场生成）
backend/backup/*.bak
backend/backup/sqlite_*.db
backend/_uvicorn*.log

# Streamlit
.streamlit/

# OS
.DS_Store
Thumbs.db

# OpenStax 原始教材 PDF（体积大,仅保留本地,不提交）
backend/data/sample_docs/openstax_*/*.pdf
